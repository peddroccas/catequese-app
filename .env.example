# Endereço da API (catequese-nest). Entra no build, então muda só com novo deploy
VITE_API_URL="http://localhost:3333"

# Nome do produto (menu e aba do navegador antes da paroquia carregar)
# VITE_APP_NAME="Catequese"
# Paroquia da inscricao quando o endereco nao traz o slug (/inscricao). Igual ao DEFAULT_PARISH_SLUG da API
# VITE_DEFAULT_PARISH_SLUG="aparecida-gama"
# Recuperacao de senha por e-mail na tela "Esqueci minha senha". Ligue (true) so depois de configurar o envio de e-mail na API
# VITE_PASSWORD_RESET_EMAIL="true"
